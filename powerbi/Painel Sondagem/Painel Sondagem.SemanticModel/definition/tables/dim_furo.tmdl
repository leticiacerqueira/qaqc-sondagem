				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"furo", type text}, {"este", type number}, {"norte", type number}, {"cota", type number}, {"prof_final", type number}, {"azimute", type number}, {"mergulho", type number}, {"data_inicio", type date}, {"sonda", type text}, {"intercepto_de_m", type number}, {"espessura_m", type number}, {"teor_cg_pct", type number}, {"pct_metro", type number}, {"status_qaqc", type text}}, "en-US")
